function sq_text(_x, _y, _text, _colour, _scale) {
    _text = string_upper(_text);
    draw_set_colour(_colour);
    for (var _i = 1; _i <= string_length(_text); ++_i) {
        var _char = string_char_at(_text, _i);
        var _index = string_pos(_char, global.sq_font.chars) - 1;
        if (_index < 0) continue;
        var _glyph = global.sq_font.rows[_index];
        for (var _gy = 0; _gy < 7; ++_gy) {
            for (var _gx = 0; _gx < 5; ++_gx) {
                if (string_char_at(_glyph, _gy * 6 + _gx + 1) != "1") continue;
                var _px = floor(_x + ((_i - 1) * 6 + _gx) * _scale);
                var _py = floor(_y + _gy * _scale);
                draw_rectangle(_px, _py, _px + _scale - 1, _py + _scale - 1, false);
            }
        }
    }
}
